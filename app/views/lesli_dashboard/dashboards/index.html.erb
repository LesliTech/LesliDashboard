<%= render LesliView::Layout::Container.new("dashboards-index") do %>
    <%= render LesliView::Components::Header.new(t("lesli_dashboard.dashboards.title")) do %>
        <% if dashboard_action_allowed?(:new) %>
            <%= render LesliView::Elements::Button.new(
                t("lesli_dashboard.dashboards.new"), url: new_managed_dashboard_path, icon: "add"
            ) %>
        <% end %>
    <% end %>

    <%= render LesliView::Elements::Table.new(
        columns: %w[name engine default].map { |field| { field: field, label: t("lesli_dashboard.dashboards.#{field}") } },
        records: @dashboards.map { |dashboard| {
            id: dashboard.id,
            name: dashboard.name,
            engine: dashboard.engine,
            default: t("lesli_dashboard.dashboards.#{dashboard.default? ? 'yes' : 'no'}")
        } },
        link: ->(dashboard) { managed_dashboard_path(dashboard.fetch(:id)) },
        empty: t("lesli_dashboard.dashboards.empty")
    ) %>
<% end %>

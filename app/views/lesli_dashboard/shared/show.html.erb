<%# The main layout already includes this stylesheet inside LesliDashboard. %>
<% content_for :head do %>
    <%= stylesheet_link_tag "lesli_dashboard/dashboard", media: "all", "data-turbo-track": "dynamic" %>
<% end %>

<%= render(LesliView::Layout::Container.new("dashboards-show", :dashboard => false)) do %>

    <%= render("lesli_dashboard/shared/header") %>

    <%= render("lesli_dashboard/shared/navigation") %>

    <% if @components.empty? %>
        <section
            class="mt-6 rounded-2xl border border-dashed border-neutral-300 bg-neutral-50/70 px-6 py-12 sm:py-16"
            aria-label="<%= t("lesli_dashboard.dashboards.empty") %>">
            <%= render(LesliView::Elements::Empty.new(text: t("lesli_dashboard.dashboards.empty"))) %>
            <div class="mt-6 flex justify-center">
                <% if @dashboard&.persisted? %>
                    <%= render LesliView::Elements::Button.new(
                        t("lesli_dashboard.components.add"),
                        url: lesli_dashboard.managed_dashboard_components_path(@dashboard), icon: "add"
                    ) %>
                <% else %>
                    <%= render LesliView::Elements::Button.new(
                        t("lesli_dashboard.dashboards.new"),
                        url: lesli_dashboard.new_managed_dashboard_path(engine: @dashboard_engine), icon: "add"
                    ) %>
                <% end %>
            </div>
        </section>
    <% else %>
        <section class="mt-6 w-full" aria-label="<%= t("lesli_dashboard.dashboards.widgets") %>">
            <div class="grid grid-cols-12 items-stretch gap-4 sm:gap-5 lg:gap-6">
                <% @components.each do |component| %>
                    <article
                        class="col-span-12 min-w-0 <%= @dashboard_presenter.width_class(component) %>"
                        data-dashboard-component="<%= component.component %>">
                        <div class="h-full min-w-0 [&>*]:h-full [&_.box]:h-full">
                            <%= render(@dashboard_presenter.partial_path(component), { :component => component }) %>
                        </div>
                    </article>
                <% end %>
            </div>
        </section>
    <% end %>
<% end %>
